# What a deployment needs, and nothing it does not.
#
# Copy this into the host's environment settings — Railway Variables, Render
# Environment, Fly secrets. Do not commit the filled-in version and do not put
# it in the build context: `next build` copies .env files into
# .next/standalone, where they would override what the container is given.
#
# lib/env.ts refuses to start in production on a missing or example value, so a
# mistake here stops the deployment coming up rather than running it wrong. The
# three at the top are the only ones that are mandatory.

# ---------------------------------------------------------------- required

# The managed Postgres. Every host gives you this string; on Railway and Render
# it can be referenced from the database rather than pasted.
DATABASE_URL=

# Signs session cookies. Any host's "generate" button is fine, or:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Encrypts connected-account credentials at rest (AES-256-GCM).
# Exactly 32 bytes as 64 hex characters — a host's generic random string will
# be refused, so generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Back this up somewhere separate before the first deployment. Losing it does
# not lock you out of the platform; it makes every credential users have
# connected permanently unreadable, and they all have to reconnect. Changing it
# later has the same effect.
SECRETS_KEY=

# ------------------------------------------------------------------- n8n
#
# Leave N8N_DRIVER as "mock" for the first deployment. Everything renders, runs
# complete against the in-process fake, and nothing leaves the host — so a
# broken webhook URL cannot be mistaken for a broken platform. Switch to "live"
# once the URLs below are filled in and one round trip has been seen to work.
N8N_DRIVER=mock

N8N_BASE_URL=https://fsb.tyc.mybluehost.me/api/v1
# Only used by two reads that degrade gracefully. No user path needs it.
N8N_API_KEY=

# Must equal the value in the "Platform Token" credential in n8n, which is
# attached to all five webhook nodes as Header Auth on x-platform-token.
N8N_WEBHOOK_TOKEN=

N8N_UPLOAD_WEBHOOK_URL=https://fsb.tyc.mybluehost.me/webhook/mp-upload
N8N_INSTALL_WEBHOOK_URL=https://fsb.tyc.mybluehost.me/webhook/mp-install
N8N_UNINSTALL_WEBHOOK_URL=https://fsb.tyc.mybluehost.me/webhook/mp-uninstall
N8N_DISPATCH_WEBHOOK_URL=https://fsb.tyc.mybluehost.me/webhook/mp-dispatch
N8N_STORAGE_WEBHOOK_URL=https://fsb.tyc.mybluehost.me/webhook/mp-storage

N8N_DISPATCHER_WORKFLOW_ID=LDwKKC7LxuXYTckX
N8N_STORAGE_WORKFLOW_ID=TcF7pr6F3ZIt2R4A

# The conversation UI is not built, so this stays empty. See "Honest gaps".
N8N_ORCHESTRATOR_CHAT_URL=

# ---------------------------------------------------------------- tokens
#
# Both protect an endpoint that has no session in front of it. Empty is a valid
# answer and disables the endpoint, which is the safe default — but the example
# values from .env.example are refused, because they read as protected while
# being published in this repository.

# Authorises POST /api/schedules/tick. Leave empty and no schedule ever fires;
# set it and give the same value to whatever calls the endpoint every minute.
SCHEDULE_TOKEN=

# Authorises POST /api/n8n/sync, which MP · Publish Sync calls to update the
# catalogue mirror. Leave empty until that workflow is pointed at this host.
N8N_SYNC_TOKEN=
