# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright's own output: traces and screenshots from a failed e2e run
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the example belongs in the repo; the real one never does
!.env.example
# Holds no values, only the names to set and how to generate them. Without this
# line the deployment checklist is a file nobody but its author ever sees.
!.env.production.example

# generated by `prisma generate`
/src/generated/
