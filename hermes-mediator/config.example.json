{
  "listen": "127.0.0.1:8790",
  "db_path": "/var/lib/hermes-mediator/ledger.sqlite",
  "upstream_base_url": "https://PROVIDER.example/v1",
  "upstream_key_file": "/etc/hermes-mediator/upstream.key",
  "max_output_tokens": 4096,
  "default_output_tokens": 1024,
  "max_body_bytes": 2000000,
  "upstream_timeout_s": 120,
  "per_tenant_concurrency": 2,
  "models": {
    "hermes-chat": {
      "upstream": "PROVIDER-MODEL-ID",
      "in_micro_per_mtok": 0,
      "out_micro_per_mtok": 0
    }
  }
}
