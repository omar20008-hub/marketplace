# ---------------------------------------------------------------- platform

# Postgres for the platform's own database. docker-compose.yml publishes 5433 so
# it never collides with a Postgres you already run on 5432. Point this at your
# own instance instead if you prefer.
DATABASE_URL="postgresql://builder:builder@localhost:5433/builder?schema=public"

# Signs session cookies. Any long random string; change it for anything real.
AUTH_SECRET="dev-only-secret-change-me-to-something-long-and-random"
# Encrypts connected-account credentials at rest (AES-256-GCM).
# 32 bytes as 64 hex characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing or changing it makes every stored credential unreadable; users would
# have to reconnect. Keep it out of the repo and back it up separately.
SECRETS_KEY=""

# ------------------------------------------------------------------- n8n
#
# "mock" runs the whole platform against an in-process fake of the eight
# workflows: nothing leaves the machine and every screen has live data. This is
# the default because three of the workflows still use a Form Trigger and return
# an HTML page rather than JSON (see the open decisions in the handover doc).
#
# "live" switches to the real instance. Flip it once the triggers are webhooks.
N8N_DRIVER="mock"

# Instance address including /api/v1.
N8N_BASE_URL="https://n8n.example.com/api/v1"

# WARNING: this key has full control of the instance, including every other
# workflow and credential on it. Server-side only. It must never be sent to the
# browser, to a creator, or to a user.
N8N_API_KEY=""

# Shared secret the platform sends as a header on every webhook call, and that
# n8n checks with Header Auth. Without it, anyone who learns a webhook URL can
# call these workflows directly.
N8N_WEBHOOK_TOKEN=""

# Webhook URLs — the three workflows the platform calls directly.
N8N_UPLOAD_WEBHOOK_URL=""
N8N_INSTALL_WEBHOOK_URL=""
N8N_UNINSTALL_WEBHOOK_URL=""

# Dispatcher and Storage each have a Webhook Trigger beside the Execute Workflow
# Trigger the Orchestrator calls them through, so the platform reaches all five
# workflows the same way. With these set, nothing a user does needs the API key.
N8N_DISPATCH_WEBHOOK_URL=""
N8N_STORAGE_WEBHOOK_URL=""

# Still needed by the Orchestrator's own tool catalogue, and by the REST reads.
N8N_DISPATCHER_WORKFLOW_ID="LDwKKC7LxuXYTckX"
N8N_STORAGE_WORKFLOW_ID="TcF7pr6F3ZIt2R4A"

# Chat Trigger URL for MP · Orchestrator. sessionId must be the authenticated
# user id, never a random one — it decides which tools the conversation sees.
N8N_ORCHESTRATOR_CHAT_URL=""

# Token that MP · Publish Sync must present to POST /api/n8n/sync.
N8N_SYNC_TOKEN="dev-sync-token"

# ------------------------------------------------------------- scheduler
#
# Authorises POST /api/schedules/tick, the scheduler's heartbeat. The platform
# has no clock of its own, so something outside calls that endpoint about once a
# minute — a cron daemon, a platform cron, a GitHub Action, or an n8n Schedule
# Trigger. Whatever it is sends this value as the x-schedule-token header.
#
# Leaving it empty disables the endpoint rather than leaving it open.
#
#   * * * * * curl -fsS -X POST https://example.com/api/schedules/tick \
#               -H "x-schedule-token: $SCHEDULE_TOKEN"
#
# In development, `npm run scheduler` polls it for you.
SCHEDULE_TOKEN="dev-schedule-token"
