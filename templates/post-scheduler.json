      "parameters": {
        "method": "GET",
        "url": "https://graph.facebook.com/v21.0/me/accounts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "id,name,access_token,instagram_business_account"
