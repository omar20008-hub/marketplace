    {
      "id": "7c1e9b40-2d6a-4f3e-8a51-9e0f1a2b3c13",
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        640
      ],
      "parameters": {
        "jsCode": "const page = $('Pick Page').first().json;\nconst lines = [];\nlet failed = false;\nconst why = (r) => (r && r.error && (r.error.message || r.error)) || (r && r.message) || 'فشل غير معروف';\nif (page.facebook) {\n  const r = $('Publish Facebook').first().json;\n  if (r.id || r.post_id) lines.push('فيسبوك (' + page.pageName + '): ' + (r.post_id || r.id));\n  else { failed = true; lines.push('فيسبوك: ' + why(r)); }\n}\nif (page.instagram) {\n  const container = $('Create IG Container').first().json;\n  const r = $('Publish IG').isExecuted ? $('Publish IG').first().json : container;\n  if (container.id && r.id) lines.push('إنستغرام: ' + r.id);\n  else { failed = true; lines.push('إنستغرام: ' + why(container.error ? container : r)); }\n}\nif (failed) throw new Error(lines.join(' | '));\nreturn [{ json: { output: 'تم النشر. ' + lines.join(' | ') } }];"
      }
    }
