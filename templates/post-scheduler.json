    {
      "id": "7c1e9b40-2d6a-4f3e-8a51-9e0f1a2b3c06",
      "name": "Pick Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        640
      ],
      "parameters": {
        "jsCode": "const input = $('Post Scheduler').first().json;\nconst answer = $input.first().json;\nif (answer.error) throw new Error('فيسبوك رفض الطلب: ' + (answer.error.message || answer.error));\nconst pages = answer.data || [];\nconst wanted = String(input.networks || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);\nconst page = pages[0];\nif (!page) throw new Error('لا توجد صفحة فيسبوك يمكن النشر عليها بهذا الحساب.');\nconst igId = (page.instagram_business_account && page.instagram_business_account.id) || '';\nif (wanted.includes('instagram') && !igId) throw new Error('الصفحة \"' + page.name + '\" غير مرتبطة بحساب إنستغرام للأعمال.');\nconst mediaUrl = input.mediaUrl && input.mediaUrl !== 'none' ? input.mediaUrl : '';\nif (wanted.includes('instagram') && !mediaUrl) throw new Error('إنستغرام يتطلب صورة.');\nreturn [{ json: { caption: input.caption, mediaUrl: mediaUrl, pageId: page.id, pageName: page.name,\n  pageToken: page.access_token, igId, facebook: wanted.includes('facebook'), instagram: wanted.includes('instagram') } }];"
      }
    },
    {
      "id": "7c1e9b40-2d6a-4f3e-8a51-9e0f1a2b3c07",
      "name": "Facebook?",
      "type": "n8n-nodes-base.if",
