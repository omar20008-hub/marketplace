// Builder — platform database.
//
// Division of ownership (from the engineering handover reference):
//   n8n  owns execution and operational data (the mp_* Data Tables).
//   this owns everything that is displayed, or entered by a human.
//
// Product / Installation / Run below MIRROR mp_templates / mp_installations /
// mp_runs. The mirror exists because the marketplace has to search, filter,
// sort, rate and categorise, none of which the n8n Data Table API can do per
// request. It is refreshed by POST /api/n8n/sync (called by MP · Publish Sync)
// and by an on-demand pull.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 takes the connection URL from prisma.config.ts (for migrations) and
// from the driver adapter in src/lib/db.ts (at runtime), never from here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum Role {
  USER
  CREATOR
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  passwordHash String
  roles        Role[]  @default([USER])
  orgName      String?
  initials     String
  avatarTint   String  @default("#dfe7f5")
  avatarInk    String  @default("#1f4f9a")

  planId   String
  plan     Plan      @relation(fields: [planId], references: [id])
  renewsAt DateTime?
  credits  Int       @default(0)
  // Stripe ids, set by the billing webhook. Null for a user on the free plan.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Creator-facing identity, shown on product cards.
  creatorName     String?
  creatorVerified Boolean @default(false)

  createdAt DateTime @default(now())

  // Whether the assistant may learn lasting facts about this person from what they
  // write (see src/server/memory.ts). Things they ask it to remember are kept either way.
  memoryAuto Boolean @default(true)

  products      Product[]
  installations Installation[]
  connectors    Connector[]
  adCampaigns   AdCampaign[]
  runs          Run[]
  threads       Thread[]
  mediaUploads  MediaUpload[]
  userFiles     UserFile[]
  reviews       Review[]
  submissions   Submission[]
  schedules     Schedule[]
  auditLogs     AuditLog[]
  knowledge     KnowledgeSource[]
  memories      UserMemory[]
  memoryFiles   MemoryFile[]
  channelLinks      ChannelLink[]
  channelLinkCodes  ChannelLinkCode[]
  siteLogins        SiteLogin[]
  siteLoginRequests SiteLoginRequest[]
  agentKeys          AgentKey[]
  orchestratorPendingActions OrchestratorPendingAction[]
}

// ------------------------------------------------------------ chat channels

// A person's account on a chat channel, linked to their platform user. The
// channel's own id is the key (for Telegram, the numeric user id), so one
// channel account belongs to one platform user, and a user has one per channel.
model ChannelLink {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel    String // "telegram"
  externalId String
  linkedAt   DateTime @default(now())

  @@unique([channel, externalId])
  @@unique([userId, channel])
}

// A one-time code the person sends to the bot as "/link <code>". Only its
// SHA-256 is stored; the code itself is shown once, to the person who asked.
model ChannelLinkCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, channel])
}

// Plans, credits and quotas live only here. No workflow enforces them.
model Plan {
  id               String @id
  name             String
  monthlyRuns      Int
  storageBytes     BigInt
  monthlyCredits   Int
  priceMonthly     Int    @default(0)
  /// Folders a user may attach across all their installations.
  knowledgeSources Int    @default(1)
  /// Readable files a user may have indexed across all their folders.
  knowledgeFiles   Int    @default(200)
  users            User[]
}

// ---------------------------------------------------------------- catalogue

enum ProductKind {
  AGENT
  WORKFLOW
}

enum ActionType {
  READ
  WRITE
}

// The first seven mirror mp_templates.status one for one. RESTRICTED and
// SUSPENDED are platform-only states the design shows but that enum has no
// room for.
enum ProductStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  BLOCKED_DURABILITY
  WITHDRAWN
  DELETED
  SECURITY_HOLD
  RESTRICTED
  SUSPENDED
}

model Product {
  id   String @id @default(cuid())
  slug String @unique

  // Keys into n8n. Null until MP · Upload & Provision has accepted the file.
  templateId    String? @unique
  n8nWorkflowId String?

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  title        String
  summary      String // one line, shown on the card
  description  String // "What it does"
  needsFromYou String // "What it needs from you"
  kind         ProductKind
  category     String
  actionType   ActionType    @default(READ)
  status       ProductStatus @default(DRAFT)

  // Runs on a specific model rather than the plan's included one, so a run
  // spends credits. With none left, the product reads as "Plan limit".
  usesCredits Boolean @default(false)

  version              String   @default("1.0")
  contentHash          String?
  nodeCount            Int      @default(0)
  inputSchema          Json     @default("[]")
  outputs              Json     @default("[]")
  requiredCredentials  String[] @default([])
  externalHosts        String[] @default([])
  flaggedNodes         String[] @default([])
  credentialDurability String   @default("durable")

  /// How the published version is invoked: "on_demand" (asked for in the
  /// conversation — the only kind before Upload & Provision stopped rejecting
  /// AI and Google Drive nodes), "scheduled" (a Schedule Trigger inside the
  /// workflow itself, running in n8n independently of this platform's own
  /// Schedule model below) or "event" (an external trigger, e.g. inbound
  /// mail). Can arrive composite ("scheduled,event") on the rare template with
  /// more than one trigger. Copied from the accepted Submission at upload and
  /// again at approval, same as nodeCount and requiredCredentials above.
  invocationMode String   @default("on_demand")
  /// Field names Upload & Provision inferred as this template's on_demand
  /// inputs. Meaningless for scheduled/event, which take no inputs at call time.
  inputFields    String[] @default([])
  /// The template searches the user's own files through the platform (it carries
  /// the __MP_KNOWLEDGE_KEY__ placeholder). Set from the uploaded file itself, so
  /// the setup wizard knows to ask for a folder.
  usesKnowledge  Boolean  @default(false)
  /// True for a template that queues social posts through /api/posts (Post scheduler).
  /// Set at upload from the file itself; adds the Posts screen to My workspace.
  usesPosts      Boolean  @default(false)

  // Marketplace signals. Ratings are platform-owned, health is derived from runs.
  ratingAvg   Float   @default(0)
  ratingCount Int     @default(0)
  runsLast30d Int     @default(0)
  healthPct   Float   @default(100)
  featured    Boolean @default(false)
  trending    Boolean @default(false)

  securityCheckedAt DateTime?
  platformApproved  Boolean   @default(false)
  restrictionNote   String?
  rejectionReason   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions      ProductVersion[]
  requirements  Requirement[]
  reviews       Review[]
  installations Installation[]
  runs          Run[]
  submissions   Submission[]

  @@index([status, category])
}

model ProductVersion {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  version       String
  current       Boolean   @default(false)
  deprecated    Boolean   @default(false)
  n8nWorkflowId String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([productId, version])
}

enum ProvidedBy {
  PLATFORM // the platform supplies it, the user does nothing
  PLATFORM_OR_OWN // platform connection, the user may switch to their own account
  USER // the user must connect their own account
}

enum RequirementKind {
  MODEL
  CONNECTION
  STORAGE
}

// One row per line of the product page's "What it needs" table.
model Requirement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind           RequirementKind
  label          String
  note           String? // "— publish posts"
  credentialType String? // maps to mp_credential_types.credentialType
  providedBy     ProvidedBy
  sortOrder      Int             @default(0)
}

// Credentials the platform owns and hands to whichever runtime needs them (n8n now,
// Hermes or another platform later). Encrypted with SECRETS_KEY, like connected
// accounts. Written only from the admin screen; never read back to a page.
model PlatformSecret {
  name        String   @id
  secretJson  String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

// ------------------------------------------------------- connected accounts

enum AccountScope {
  OWN // the user's own account
  PLATFORM // a shared platform connection, no action needed
}

enum AccountStatus {
  ACTIVE
  EXPIRED
  PENDING
  REVOKED
}

// A reusable connection to an outside tool. The design lets one connector serve
// many products, while n8n creates a credential per installation, so
// InstallationCredential below records which n8n credential each installation
// got from this connector.
model Connector {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialType String // e.g. facebookGraphApi
  displayName    String // "Instagram Business"
  initials       String
  accountRef     String? // "nora@acme.co", "acme.slack.com"
  scope          AccountScope  @default(OWN)
  status         AccountStatus @default(ACTIVE)
  reusable       Boolean       @default(true) // "Every product that asks" vs "This product only"

  // Secret material never reaches the browser and is never returned by an API.
  secretJson String?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  links            InstallationCredential[]
  knowledgeSources KnowledgeSource[]

  @@unique([userId, credentialType, accountRef])
}

// ---------------------------------------------------------- installations

enum InstallationStatus {
  PARTIAL // created here, not yet installed in n8n, a connection is missing
  ACTIVE
  DISABLED
  UNINSTALLED
}

model Installation {
  id             String  @id @default(cuid())
  installationId String? @unique // inst_xxxxx, from MP · Install Template
  userId         String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])

  pinnedVersion      String
  instanceWorkflowId String?
  /// n8n credential ids created for this copy (one per credential type, plus the
  /// knowledge key's). Uninstall deletes them with the copy. Empty for installations
  /// made before this was recorded, which uninstall handles through n8n.
  n8nCredentialIds   String[]           @default([])
  storageBackend     String             @default("platform")
  status             InstallationStatus @default(PARTIAL)
  failureCount       Int                @default(0)
  favourite          Boolean            @default(false)
  attentionNote      String?

  /// Cron the user chose for a scheduled product, sent to MP · Install
  /// Template as-is. Null means the template's own built-in default schedule
  /// applies. Unused for on_demand/event products.
  schedule         String?
  /// From MP · Install Template's reply for scheduled/event products: "active"
  /// once n8n turned the trigger on, "activation_failed" if the install call
  /// itself succeeded (installationId exists) but n8n could not activate the
  /// trigger — which reads as "needs review", not as a working tool, in My
  /// workspace. Meaningless for on_demand, where readinessFor() already
  /// decides what shows instead.
  activationStatus String  @default("active")

  installedAt DateTime  @default(now())
  lastRunAt   DateTime?

  credentials InstallationCredential[]
  runs        Run[]
  schedules   Schedule[]
  posts       ScheduledPost[]

  /// sha256 of the key this installation's n8n instance uses to search its
  /// knowledge sources. The key itself exists only in that instance; here there
  /// is nothing to leak. A new one is issued on every activation.
  knowledgeKeyHash String?           @unique
  knowledgeSources KnowledgeSource[]
  storageObjects   StorageObject[]

  @@unique([userId, productId])
}

model InstallationCredential {
  id              String            @id @default(cuid())
  installationId  String
  installation    Installation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectorId     String?
  connector       Connector?        @relation(fields: [connectorId], references: [id])
  credentialType  String
  n8nCredentialId String?

  @@unique([installationId, credentialType])
}

model StorageAdapter {
  backend           String  @id // platform | drive | s3
  displayName       String
  adapterWorkflowId String?
  credentialType    String?
  supportsPresign   Boolean @default(false)
  active            Boolean @default(false)
}

// ------------------------------------------------------------------- runs

enum RunResult {
  RUNNING
  SUCCESS
  PARTIAL
  ERROR
  DENIED
  INCOMPLETE
  BLOCKED
  STOPPED
}

model Run {
  id             String       @id @default(cuid())
  runId          String       @unique // short handle shown in the UI: 8f2c
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  productVersion String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  result     RunResult @default(RUNNING)
  errorType  String?
  message    String?

  // Cost is platform-side. mp_runs has no cost column.
  costCredits Int     @default(0)
  charged     Boolean @default(true)
  chargeNote  String? // "not charged"

  threadId String?
  thread   Thread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  steps     RunStep[]
  artifacts Artifact[]

  @@index([userId, startedAt])
}

enum StepStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

// The dispatcher returns one result with no progress. These rows are synthesised
// by the platform from the template's declared steps so the thread can show
// "step 3 of 4". In live mode they collapse to a single step.
model RunStep {
  id         String     @id @default(cuid())
  runId      String
  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  idx        Int
  label      String
  status     StepStatus @default(QUEUED)
  durationMs Int?

  @@unique([runId, idx])
}

model Artifact {
  id          String   @id @default(cuid())
  runId       String
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name        String
  path        String
  mimeType    String
  sizeBytes   Int
  backend     String   @default("platform")
  objectRef   String
  deliveredTo String[] @default([])
  keepDays    Int      @default(90)
  createdAt   DateTime @default(now())
}

// ------------------------------------------------------------ conversation

enum MemorySource {
  EXPLICIT
  AUTO
}

/// A text file in a person's memory ("Profile", "Work", …). Facts are lines added to
/// it; the person can read and edit it. The platform writes these (never n8n) and puts
/// the newest files in front of what the Orchestrator reads.
model MemoryFile {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

/// LEGACY: one row per sentence, replaced by MemoryFile. Its rows were copied into a
/// "Notes" file by migration 20261005120000_memory_files; nothing reads or writes it
/// now. Drop it in a later migration once that has run everywhere.
model UserMemory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  source    MemorySource @default(EXPLICIT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, updatedAt])
}

model Thread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// Set on the one thread that holds a chat channel's conversation ("whatsapp"),
  /// so it is kept in the platform like any other; null for threads started here.
  channel   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages                   Message[]
  runs                       Run[]
  orchestratorPendingActions OrchestratorPendingAction[]

  @@index([userId, updatedAt])
  @@index([userId, channel])
}

/// A write the Orchestrator proposed and is waiting for the person to confirm.
/// It runs only when a later message from that person confirms it, and it is
/// consumed by that run. Proposals older than the confirmation window are ignored.
model OrchestratorPendingAction {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId            String
  thread              Thread                    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  installationId      String
  argsKey             String
  proposedByMessageId String
  status              OrchestratorPendingStatus @default(PENDING)
  createdAt           DateTime                  @default(now())

  @@index([userId, threadId, installationId, status])
}

enum OrchestratorPendingStatus {
  PENDING
  CONSUMED
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id        String      @id @default(cuid())
  threadId  String
  thread    Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      MessageRole
  body      String
  runId     String?
  createdAt DateTime    @default(now())
}

/// Per-user scheduling, which the workflow contracts have no answer for: there
/// is no schedule table in n8n's side of the boundary, so the cadence, the
/// saved inputs and the record of what happened all live here.
/// Which node types a creator's workflow may use, and how each is treated.
/// Read by the upload check; changed only by someone who owns the policy.
model NodeRule {
  nodeType String @id
  verdict  String
  note     String @default("")
}

/// Whether a credential type can be kept for an installation, and how it is
/// connected. OAuth types need the platform's app registered with the provider.
model CredentialRule {
  credentialType String   @id
  durability     String
  appRegistered  Boolean  @default(false)
  authFlow       String?
  flowReady      Boolean?
  note           String   @default("")
}

/// Files a product writes for one installation (the platform's own storage
/// destination). Keyed by the platform installation, so one installation can never
/// read another's files.
model StorageObject {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  path           String
  mimeType       String
  size           Int
  content        Bytes
  writtenAt      DateTime     @default(now())

  @@unique([installationId, path])
}

model Schedule {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  label          String
  /// Five-field cron, read in UTC. See lib/cron.ts for the supported subset.
  cron           String
  enabled        Boolean      @default(true)

  /// The values a scheduled run is started with. A run cannot stop to ask, so
  /// whatever the product declares as required is collected once, here, when
  /// the schedule is made — otherwise every firing would come back INCOMPLETE.
  args Json @default("{}")

  /// The next firing due, computed from `cron` whenever the schedule changes or
  /// fires. Null means it has never been computed; the tick fills it in rather
  /// than treating it as "overdue since the epoch" and firing at once.
  nextRunAt  DateTime?
  lastRunAt  DateTime?
  lastStatus String?
  lastRunId  String?

  createdAt DateTime @default(now())

  @@index([enabled, nextRunAt])
}

// ------------------------------------------------- creator studio and review

enum SubmissionState {
  VALIDATING
  VALIDATION_FAILED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum CheckState {
  PASSED
  PARTIAL
  FAILED
  HUMAN_REVIEW
  FIXED
}

// Upload & Provision returns a flat accept or reject. The six categories below
// are the platform's presentation of that reply, filled from the strings it
// returns.
model Submission {
  id              String          @id @default(cuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  creatorId       String
  creator         User            @relation(fields: [creatorId], references: [id])
  version         String
  state           SubmissionState @default(VALIDATING)
  submittedAt     DateTime        @default(now())
  checkDurationMs Int?

  parsing       CheckState @default(PASSED)
  secrets       CheckState @default(PASSED)
  compatibility CheckState @default(PASSED)
  security      CheckState @default(PASSED)
  quality       CheckState @default(PASSED)
  policy        CheckState @default(PASSED)

  secretsRemoved Int       @default(0)
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?

  /// See Product.invocationMode — this is where it first lands, from the same
  /// Upload & Provision reply, before a decision copies it onto the product.
  invocationMode  String   @default("on_demand")
  inputFields     String[] @default([])
  /// "confident" needs nothing from the creator. "needs_confirmation" means
  /// Upload & Provision inferred something ambiguous (dynamic data access, or
  /// a trigger worth a second look) — shown to the creator as information
  /// alongside `notes`, since there is no n8n API path yet to confirm or edit
  /// it; the human review inside n8n is what actually settles it.
  inferenceStatus String   @default("confident")
  /// Arabic prose describing any automatic conversion Upload & Provision made
  /// (a node retargeted, a trigger swapped for a chat-callable one). Shown to
  /// the creator as transparency, not as an error.
  notes           String?

  issues SubmissionIssue[]
}

enum IssueSeverity {
  BLOCKER
  HUMAN_REVIEW
  FIXED
  QUALITY
  POLICY
}

model SubmissionIssue {
  id           String        @id @default(cuid())
  submissionId String
  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  severity     IssueSeverity
  title        String
  detail       String
  step         String?
  needsAnswer  Boolean       @default(false)
  answer       String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  subject   String
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --------------------------------------------------------------- knowledge
//
// What a user's agents may read: a folder the platform watches, the files in it,
// and those files cut into embedded chunks. Owned by the platform, not n8n — a
// workflow asks for passages through the retrieval endpoint and never touches
// these tables.

enum KnowledgeSourceStatus {
  ACTIVE
  NEEDS_RECONNECT // the Google connection died; nothing syncs until it is renewed
  PAUSED
}

enum KnowledgeFileStatus {
  PENDING // seen, waiting for the worker
  INDEXING
  READY
  FAILED // retries exhausted; `error` says why, a change to the file retries it
  UNSUPPORTED // a type we cannot read; shown to the user, never silently skipped
  REMOVED // gone from the folder; its chunks are deleted
}

model KnowledgeSource {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A source belongs to one installation: what an agent may read is what its
  /// own user attached to it, never the user's other folders.
  installationId String
  installation   Installation          @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectorId    String
  connector      Connector             @relation(fields: [connectorId], references: [id])
  provider       String                @default("gdrive")
  folderId       String
  folderName     String
  status         KnowledgeSourceStatus @default(ACTIVE)

  /// Drive changes.list cursor and the push channel that keeps it fresh (M3).
  changesToken      String?
  channelId         String?   @unique
  channelResourceId String?
  channelToken      String?
  channelExpiry     DateTime?
  /// Every folder in the watched tree (the root included), so a change can be
  /// judged relevant by its parents without a Drive call per file.
  folderIds         String[]

  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())

  files KnowledgeFile[]

  @@unique([installationId, provider, folderId])
  @@index([connectorId])
}

model KnowledgeFile {
  id              String              @id @default(cuid())
  sourceId        String
  source          KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  name            String
  mimeType        String
  path            String? // folder path inside the source, for citations
  webUrl          String?
  /// md5 for binary files, modifiedTime for Google-native ones: whatever changes
  /// when the content does.
  revision        String
  status          KnowledgeFileStatus @default(PENDING)
  error           String?
  chunkCount      Int                 @default(0)
  indexedRevision String?
  /// "<revision>:<chunk count>" of a pass that stopped part-way (a rate limit). The
  /// chunks written so far stay, hidden because the file is not READY, and the next
  /// pass carries on after them instead of embedding the whole file again.
  partialRevision String?
  /// Which embedding model produced this file's chunks (see embeddingTag()).
  /// Vectors from different models cannot be compared, so search ignores a file
  /// whose tag is not the current one until it is re-indexed. Null is a file
  /// indexed before this was recorded, which used the current default.
  embeddingModel  String?
  indexedAt       DateTime?
  createdAt       DateTime            @default(now())

  chunks KnowledgeChunk[]

  @@unique([sourceId, externalId])
  @@index([sourceId, status])
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  fileId    String
  file      KnowledgeFile               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sourceId  String
  ordinal   Int
  content   String
  /// Written and searched with raw SQL — Prisma cannot express pgvector. Absent
  /// on a database without the extension (see the migration).
  embedding Unsupported("vector(768)")?

  @@index([sourceId])
  @@index([fileId, ordinal])
}

enum KnowledgeJobKind {
  SYNC_SOURCE
  SYNC_CHANGES // a push notification arrived: read the changes feed, sync only if it matters
  INDEX_FILE
}

/// A durable queue in Postgres: claimed with FOR UPDATE SKIP LOCKED under a
/// lease, so a worker that dies mid-job simply lets the lease lapse.
model KnowledgeJob {
  id          String           @id @default(cuid())
  kind        KnowledgeJobKind
  targetId    String // sourceId or fileId
  /// One pending job per (kind, target): enqueueing again while one waits is a no-op.
  dedupeKey   String           @unique
  attempts    Int              @default(0)
  runAfter    DateTime         @default(now())
  leasedUntil DateTime?
  /// Enqueued again while it was running: it goes round once more instead of being lost.
  rerun       Boolean          @default(false)
  lastError   String?
  createdAt   DateTime         @default(now())

  @@index([runAfter])
}

/// The last time each background process proved it was alive: one row per name,
/// overwritten, never a log. Read to tell "nothing is queued" from "nothing is
/// running" — a queue that never drains looks the same on screen as one that is
/// merely slow.
model Heartbeat {
  name String   @id
  at   DateTime
}

enum PostStatus {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// A social post waiting for its time. Written by an installed Post Scheduler
/// workflow through /api/posts (authenticated by the installation's own key) and
/// published by the tick, which hands each due post back to that workflow.
model ScheduledPost {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  caption  String
  /// Public https URL of the image. Required for Instagram.
  mediaUrl String?
  /// Any of "facebook", "instagram".
  networks String[]
  /// Optional Facebook Page id; empty means the first Page the token can post to.
  pageId   String?

  /// UTC.
  scheduledAt DateTime
  status      PostStatus @default(SCHEDULED)
  attempts    Int        @default(0)
  /// Claim time while PUBLISHING, so a tick that died mid-way can be recovered.
  claimedAt   DateTime?
  publishedAt DateTime?
  /// The workflow's reply on success, the reason on failure.
  result      String?

  createdAt DateTime @default(now())

  @@index([status, scheduledAt])
  @@index([installationId, status])
}

/// An image a person attached in the chat, kept so the platform can hand a public
/// link to a network that fetches it later (Instagram only publishes from a URL).
/// The link carries a random token; only its hash is stored, and the link stops
/// working at `expiresAt`, which outlasts the furthest a post can be scheduled.
model MediaUpload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  name      String
  mimeType  String
  sizeBytes Int
  data      Bytes
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// A file a person sent in a conversation (the platform chat or WhatsApp): a PDF,
/// an Office document, a text/Markdown/JSON/CSV file or an image. Kept in the
/// person's own space with the text read from it (OCR for images and scans), so
/// a later message can find it. Deleted with the account, or by the person.
model UserFile {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  mimeType       String
  sizeBytes      Int
  data           Bytes
  /// "platform" or "whatsapp": where it was sent from.
  channel        String          @default("platform")
  /// The text read from the file; empty when none could be read (see `error`).
  text           String          @default("")
  /// How the text was read: text, pdf, office or ocr. Null when it could not be.
  method         String?
  error          String?
  truncated      Boolean         @default(false)
  /// The embedding model of its chunks (see embeddingTag()); null until embedded.
  embeddingModel String?
  createdAt      DateTime        @default(now())

  chunks UserFileChunk[]

  @@index([userId, createdAt])
}

/// A passage of a UserFile, for finding it again. The vector is written and searched
/// with raw SQL, and is absent on a database without pgvector; search then falls
/// back to matching words.
model UserFileChunk {
  id        String                      @id @default(cuid())
  fileId    String
  file      UserFile                    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  ordinal   Int
  content   String
  embedding Unsupported("vector(768)")?

  @@index([userId])
  @@index([fileId, ordinal])
}

// ------------------------------------------------------------ saved site logins

// A username and password the person saved for a website, so the personal
// assistant can sign in for them. The password is sealed with SECRETS_KEY and
// is read back only by the server-side fill path, never by a page or a model.
model SiteLogin {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteUrl      String // the login page, normalised to https://host
  host         String
  username     String
  sealedSecret String // sealCredential({ password })
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastUsedAt   DateTime?

  @@unique([userId, host, username])
  @@index([userId])
}

// A one-time link the platform hands out so the person can type a login into
// the platform, not into a chat. Only the SHA-256 of the token is stored.
model SiteLoginRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteUrl   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum AdCampaignStatus {
  /// Saved, not yet sent to Meta.
  DRAFT
  /// Being created in Meta; a claim so two requests cannot both create it.
  CREATING
  /// Created in Meta and left PAUSED. Nothing is spent until it is activated.
  PAUSED
  ACTIVE
  FINISHED
  FAILED
}

/// An ads campaign the user asked for in chat, mirrored to Meta's Marketing API.
/// Written only by the server (src/server/ads/campaigns.ts). Money moves in Meta,
/// never here: the budget below is what Meta is told to spend per day.
model AdCampaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Meta's ad account, e.g. "act_123". Chosen by the user, never guessed.
  adAccountId String
  name        String
  /// One of the OUTCOME_* objectives the server accepts (see lib/ads/validate.ts).
  objective   String
  /// Minor units of the ad account's currency (cents for USD).
  dailyBudgetCents Int
  startsAt  DateTime
  endsAt    DateTime
  /// { countries: string[], ageMin: number, ageMax: number }
  targeting Json
  /// Which placements to run on: any of "facebook", "instagram".
  platforms String[]
  caption   String
  linkUrl   String
  mediaUrl  String?

  status      AdCampaignStatus @default(DRAFT)
  metaCampaignId String?
  metaAdSetId    String?
  metaAdId       String?
  /// Meta's own reason when a create call is refused. Never a token.
  error     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// A key the platform issues to one person for their own personal assistant. Only
// the SHA-256 of the key is stored, and it is shown once. Whoever holds the key
// acts as that person and nobody else, so the user id is never taken from a body.
model AgentKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash   String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}
