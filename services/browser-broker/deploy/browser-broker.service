[Unit]
Description=Browser broker (per-task browser containers)
After=docker.service browser-firewall.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/browser-broker/app
ExecStart=/opt/browser-broker/venv/bin/python -m browser_broker
Environment=BROWSER_BROKER_CONFIG=/etc/browser-broker/config.json
Restart=on-failure
RestartSec=5
# /run/browser-broker must be enterable by the group that owns the socket; the socket itself is 0660.
RuntimeDirectory=browser-broker
RuntimeDirectoryMode=0755
StateDirectory=browser-broker
StateDirectoryMode=0700
# Root is needed only to talk to Docker. Keep everything else shut.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Stop the service and every browser container it made goes with it (the broker also removes them on SIGTERM).
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
